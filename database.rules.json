{
  "rules": {
    "scores": {
      ".read": true,
      ".indexOn": ["best"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('best').isNumber() && newData.child('best').val() >= 0 && newData.child('best').val() <= 100"
      }
    },
    "crews": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('name').isString() && newData.child('name').val().length >= 3 && newData.child('name').val().length <= 24"
      }
    },
    "signups": {
      ".read": "auth != null && auth.token.email_verified === true && auth.token.email === 'you@example.com'",
      ".indexOn": ["updatedAt"],
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "market": {
      "peers": {
        ".read": true,
        "$key": { ".write": "auth != null && $key.beginsWith(auth.uid + '_')" }
      },
      "events": {
        ".read": true,
        ".indexOn": ["t"],
        "$e": { ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid" }
      }
    },
    "rooms": {
      "$room": {
        "peers": {
          ".read": "auth != null",
          "$key": { ".write": "auth != null && $key.beginsWith(auth.uid + '_')" }
        },
        "events": {
          ".read": "auth != null",
          ".indexOn": ["t"],
          "$e": { ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid" }
        }
      }
    }
  }
}
